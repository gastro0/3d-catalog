{
  "name": "3d-catalog",
  "version": "1.0.0",
  "private": true,
  "description": "ModelHub — каталог 3D-моделей на Next.js, NestJS и Supabase",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "test:catalog": "node --test tests/catalog.test.cjs",
    "dev": "concurrently --kill-others -n api,web -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace=@modelhub/web",
    "dev:api": "npm run start:dev --workspace=@modelhub/api",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "postcss": "^8.5.31"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^2.8.8"
  }
}
